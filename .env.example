# AmoCRM: субдомен (например yourcompany → yourcompany.amocrm.ru)
AMOCRM_SUBDOMAIN=
# Интеграция в кабинете AmoCRM
AMOCRM_CLIENT_ID=
AMOCRM_CLIENT_SECRET=
# Redirect URI — в настройках интеграции AmoCRM укажите тот же URL
# Локально: http://localhost:3000/api/amo/callback
AMOCRM_REDIRECT_URI=

# Bitrix24: входящий вебхук CRM (обязательно для вкладки Bitrix24)
# B24_WEBHOOK_URL=https://ваш-портал.bitrix24.ru/rest/USER_ID/SECRET/
# Опционально: id воронки сделок по умолчанию для вкладки Bitrix (если авто по имени не нужен)
# Пример: воронка «Холодный обзвон» = category/14 в URL канбана
# NEXT_PUBLIC_B24_DEFAULT_DEAL_CATEGORY_ID=14

# Защита приложения: пароль для входа (если не задан — вход не требуется)
# COOLDBASE_PASSWORD=ваш_пароль
# Секрет для подписи сессии (по умолчанию используется AMOCRM_CLIENT_SECRET)
# COOLDBASE_SECRET=случайная_строка
