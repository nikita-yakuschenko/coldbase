# AmoCRM / Kommo: субдомен (например yourcompany → yourcompany.amocrm.ru)
AMOCRM_SUBDOMAIN=your-subdomain
# Базовый домен API: amocrm.ru (РФ) или kommo.com (международные аккаунты)
AMOCRM_BASE_DOMAIN=amocrm.ru
# Интеграция в кабинете AmoCRM / Kommo
AMOCRM_CLIENT_ID=your-client-id
AMOCRM_CLIENT_SECRET=your-client-secret
# Redirect URI должен дословно совпадать с настройками интеграции
AMOCRM_REDIRECT_URI=https://asl.coldbase.module-team.ru/api/amo/callback

# Пароль входа в приложение (если не задан — авторизация отключена)
COOLDBASE_PASSWORD=your-password
# Опционально: отдельный секрет для подписи cookie сессии
# COOLDBASE_SECRET=your-random-secret

# Локально по HTTP: http://localhost:3000/api/amo/callback
# Продакшен: https://asl.coldbase.module-team.ru/api/amo/callback
